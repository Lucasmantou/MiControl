{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "MiControl 主窗口的最小权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:allow-set-app-theme",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://vb-audio.com/Cable/" }]
    }
  ]
}
